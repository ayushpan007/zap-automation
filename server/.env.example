# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017/zaps

# Where the Angular app runs (dev server proxies /api, /auth, /webhooks to this server)
CLIENT_URL=http://localhost:4200
# Public HTTPS URL GitHub can reach (ngrok/smee). Webhooks are registered at ${PUBLIC_URL}/webhooks/github
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Authorization callback URL: http://localhost:4200/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Any long random string; used to sign webhook deliveries (HMAC SHA-256)
GITHUB_WEBHOOK_SECRET=

# Signs the session cookie. Generate: openssl rand -base64 48
JWT_SECRET=
# Encrypts stored GitHub tokens (AES-256-GCM). Must be 32 bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

